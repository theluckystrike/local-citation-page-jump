  {
   "name": "printed 44 with offset minus 43",
   "args": [
    "[@Lee2020, p. 44]",
    3,
    [
     {
      "path": "References/Lee.md",
      "citekey": "Lee2020",
      "pdf": "Papers/Lee.pdf",
      "offset": -43
     }
    ]
   ],
   "expected": {
    "ok": true,
    "key": "Lee2020",
    "reference": "References/Lee.md",
    "pdf": "Papers/Lee.pdf",
    "printedPage": 44,
    "offset": -43,
    "page": 1
   }
  },
